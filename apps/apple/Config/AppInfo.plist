    <key>DSHApplicationSourceSHA</key>
    <string>$(DSH_APPLICATION_SOURCE_SHA)</string>
    <key>DSHApplicationSourceTree</key>
    <string>$(DSH_APPLICATION_SOURCE_TREE)</string>
