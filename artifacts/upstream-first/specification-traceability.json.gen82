    {
      "number": 15,
      "title": "Interaction 必须重做生命周期",
      "lineStart": 748,
      "lineEnd": 787,
      "sourceUnits": [
        {
          "line": 748,
          "text": "# 15. Interaction 必须重做生命周期"
        },
        {
          "line": 750,
          "text": "当前非常重要的可靠性问题之一是："
        },
        {
          "line": 752,
          "text": "Question / Approval 不能与某一个 HTTP request 生命周期绑定。"
        },
        {
          "line": 754,
          "text": "正确设计："
        },
        {
          "line": 756,
          "text": "```text"
        },
        {
          "line": 757,
          "text": "Agent"
        },
        {
          "line": 758,
          "text": " ↓"
        },
        {
          "line": 759,
          "text": "Host 创建 PendingInteraction"
        },
        {
          "line": 760,
          "text": " ↓"
        },
        {
          "line": 761,
          "text": "Client A 收到"
        },
        {
          "line": 762,
          "text": "Client B 收到"
        },
        {
          "line": 763,
          "text": " ↓"
        },
        {
          "line": 764,
          "text": "A 断网"
        },
        {
          "line": 765,
          "text": " ↓"
        },
        {
          "line": 766,
          "text": "B 回答"
        },
        {
          "line": 767,
          "text": " ↓"
        },
        {
          "line": 768,
          "text": "Host resolve"
        },
        {
          "line": 769,
          "text": " ↓"
        },
        {
          "line": 770,
          "text": "Agent resume"
        },
        {
          "line": 771,
          "text": "```"
        },
        {
          "line": 773,
          "text": "PendingInteraction 必须拥有："
        },
        {
          "line": 775,
          "text": "```ts"
        },
        {
          "line": 776,
          "text": "requestId"
        },
        {
          "line": 777,
          "text": "sessionId"
        },
        {
          "line": 778,
          "text": "type"
        },
        {
          "line": 779,
          "text": "createdAt"
        },
        {
          "line": 780,
          "text": "expiresAt?"
        },
        {
          "line": 781,
          "text": "status"
        },
        {
          "line": 782,
          "text": "revision"
        },
        {
          "line": 783,
          "text": "requiredPermission"
        },
        {
          "line": 784,
          "text": "```"
        },
        {
          "line": 786,
          "text": "---"
        }
      ],
      "verificationStatus": "NOT_STARTED",
      "acceptanceProven": false,
      "owner": "Interaction、Session 与恢复",
      "candidateEvidence": [
        "IMPLEMENTATION_STATUS.md",
