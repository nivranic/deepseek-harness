    {
      "number": 9,
      "title": "UI 设计语言",
      "lineStart": 541,
      "lineEnd": 582,
      "sourceUnits": [
        {
          "line": 541,
          "text": "# 9. UI 设计语言"
        },
        {
          "line": 543,
          "text": "不要自己再创建一套“Mobile Design System”。"
        },
        {
          "line": 545,
          "text": "优先使用官方："
        },
        {
          "line": 547,
          "text": "- design tokens；"
        },
        {
          "line": 548,
          "text": "- CSS variables；"
        },
        {
          "line": 549,
          "text": "- semantic colors；"
        },
        {
          "line": 550,
          "text": "- typography；"
        },
        {
          "line": 551,
          "text": "- radius；"
        },
        {
          "line": 552,
          "text": "- spacing；"
        },
        {
          "line": 553,
          "text": "- elevation；"
        },
        {
          "line": 554,
          "text": "- dark mode。"
        },
        {
          "line": 556,
          "text": "所有自定义组件应尽量："
        },
        {
          "line": 558,
          "text": "```text"
        },
        {
          "line": 559,
          "text": "官方组件"
        },
        {
          "line": 560,
          "text": "   ↓"
        },
        {
          "line": 561,
          "text": "薄 wrapper"
        },
        {
          "line": 562,
          "text": "   ↓"
        },
        {
          "line": 563,
          "text": "跨端 UI"
        },
        {
          "line": 564,
          "text": "```"
        },
        {
          "line": 566,
          "text": "而不是："
        },
        {
          "line": 568,
          "text": "```text"
        },
        {
          "line": 569,
          "text": "Web Design"
        },
        {
          "line": 570,
          "text": "iOS Design"
        },
        {
          "line": 571,
          "text": "Android Design"
        },
        {
          "line": 572,
          "text": "Windows Design"
        },
        {
          "line": 573,
          "text": "```"
        },
        {
          "line": 575,
          "text": "完全四套。"
        },
        {
          "line": 577,
          "text": "目标："
        },
        {
          "line": 579,
          "text": "> 视觉允许 platform-native 微调，但语义、层级、交互结构必须一致。"
        },
        {
          "line": 581,
          "text": "---"
        }
      ],
      "verificationStatus": "NOT_STARTED",
      "acceptanceProven": false,
      "owner": "官方架构、Host 权威和薄平台壳",
      "candidateEvidence": [
