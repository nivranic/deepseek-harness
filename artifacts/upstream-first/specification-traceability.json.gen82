    {
      "number": 8,
      "title": "Mobile UI 必须覆盖的边界",
      "lineStart": 485,
      "lineEnd": 540,
      "sourceUnits": [
        {
          "line": 485,
          "text": "# 8. Mobile UI 必须覆盖的边界"
        },
        {
          "line": 487,
          "text": "## Safe Area"
        },
        {
          "line": 489,
          "text": "iOS："
        },
        {
          "line": 491,
          "text": "- Dynamic Island；"
        },
        {
          "line": 492,
          "text": "- Home Indicator；"
        },
        {
          "line": 493,
          "text": "- landscape safe area。"
        },
        {
          "line": 495,
          "text": "必须支持："
        },
        {
          "line": 497,
          "text": "`env(safe-area-inset-*)`"
        },
        {
          "line": 499,
          "text": "## Virtual Keyboard"
        },
        {
          "line": 501,
          "text": "Composer 不得被："
        },
        {
          "line": 503,
          "text": "- iOS keyboard；"
        },
        {
          "line": 504,
          "text": "- Android IME；"
        },
        {
          "line": 505,
          "text": "- floating keyboard"
        },
        {
          "line": 507,
          "text": "挡住。"
        },
        {
          "line": 509,
          "text": "## Rotation"
        },
        {
          "line": 511,
          "text": "必须验证："
        },
        {
          "line": 513,
          "text": "- phone portrait；"
        },
        {
          "line": 514,
          "text": "- phone landscape；"
        },
        {
          "line": 515,
          "text": "- iPad portrait；"
        },
        {
          "line": 516,
          "text": "- iPad landscape；"
        },
        {
          "line": 517,
          "text": "- Android tablet。"
        },
        {
          "line": 519,
          "text": "## Input"
        },
        {
          "line": 521,
          "text": "同时支持："
        },
        {
          "line": 523,
          "text": "- touch；"
        },
        {
          "line": 524,
          "text": "- mouse；"
        },
        {
          "line": 525,
          "text": "- trackpad；"
        },
        {
          "line": 526,
          "text": "- keyboard；"
        },
        {
          "line": 527,
          "text": "- stylus。"
        },
        {
          "line": 529,
          "text": "## Foldable"
        },
        {
          "line": 531,
          "text": "Android："
        },
        {
          "line": 533,
          "text": "不能只依赖："
        },
        {
          "line": 535,
          "text": "`window.innerWidth`"
        },
        {
          "line": 537,
          "text": "应适配窗口尺寸变化。"
        },
        {
          "line": 539,
          "text": "---"
        }
      ],
      "verificationStatus": "NOT_STARTED",
