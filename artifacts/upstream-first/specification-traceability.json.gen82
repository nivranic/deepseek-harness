    {
      "number": 20,
      "title": "Device Trust",
      "lineStart": 891,
      "lineEnd": 924,
      "sourceUnits": [
        {
          "line": 891,
          "text": "# 20. Device Trust"
        },
        {
          "line": 893,
          "text": "Device Trust 继续保留，但迁移至 upstream-compatible service。"
        },
        {
          "line": 895,
          "text": "配对建议："
        },
        {
          "line": 897,
          "text": "Desktop："
        },
        {
          "line": 899,
          "text": "```text"
        },
        {
          "line": 900,
          "text": "添加设备"
        },
        {
          "line": 901,
          "text": "  ↓"
        },
        {
          "line": 902,
          "text": "生成短期 Challenge"
        },
        {
          "line": 903,
          "text": "  ↓"
        },
        {
          "line": 904,
          "text": "QR"
        },
        {
          "line": 905,
          "text": "```"
        },
        {
          "line": 907,
          "text": "Mobile："
        },
        {
          "line": 909,
          "text": "```text"
        },
        {
          "line": 910,
          "text": "扫码"
        },
        {
          "line": 911,
          "text": " ↓"
        },
        {
          "line": 912,
          "text": "生成 Device Key Pair"
        },
        {
          "line": 913,
          "text": " ↓"
        },
        {
          "line": 914,
          "text": "提交 Public Key + Proof"
        },
        {
          "line": 915,
          "text": " ↓"
        },
        {
          "line": 916,
          "text": "Host 签发 Device Grant"
        },
        {
          "line": 917,
          "text": "```"
        },
        {
          "line": 919,
          "text": "二维码里禁止保存："
        },
        {
          "line": 921,
          "text": "长期 bearer token。"
        },
        {
          "line": 923,
          "text": "---"
        }
      ],
      "verificationStatus": "NOT_STARTED",
      "acceptanceProven": false,
      "owner": "Device Trust、凭据与本地认证",
