      "evidenceLimit": "这些路径是已定位的候选证据；尚未逐条证明本节每一项要求，不授予整节 PASS。"
    },
    {
      "number": 4,
      "title": "产品最终架构",
      "lineStart": 250,
      "lineEnd": 285,
      "sourceUnits": [
        {
          "line": 250,
          "text": "# 4. 产品最终架构"
        },
        {
          "line": 252,
          "text": "目标架构："
        },
        {
          "line": 254,
          "text": "```text"
        },
        {
          "line": 255,
          "text": "                    Harness Core"
        },
        {
          "line": 256,
          "text": "                        │"
        },
        {
          "line": 257,
          "text": "            ┌───────────┴───────────┐"
        },
        {
          "line": 258,
          "text": "            │                       │"
        },
        {
          "line": 259,
          "text": "         Session                 Interaction"
        },
        {
          "line": 260,
          "text": "            │              Question / Approval"
        },
        {
          "line": 261,
          "text": "            │                       │"
        },
        {
          "line": 262,
          "text": "            └───────────┬───────────┘"
        },
        {
          "line": 263,
          "text": "                        │"
        },
        {
          "line": 264,
          "text": "                   Host Services"
        },
        {
          "line": 265,
          "text": "                        │"
        },
        {
          "line": 266,
          "text": "                   Typert Remote"
        },
        {
          "line": 267,
          "text": "                        │"
        },
        {
          "line": 268,
          "text": "                 Connection Layer"
        },
        {
          "line": 269,
          "text": "                        │"
        },
        {
          "line": 270,
          "text": "          ┌─────────────┼─────────────┐"
        },
        {
          "line": 271,
          "text": "          │             │             │"
        },
        {
          "line": 272,
          "text": "       Browser       Desktop        Remote"
        },
        {
          "line": 273,
          "text": "       Carrier       Carrier        Carrier"
        },
        {
          "line": 274,
          "text": "          │             │             │"
        },
        {
          "line": 275,
          "text": "          └─────────────┼─────────────┘"
        },
        {
          "line": 276,
          "text": "                        │"
        },
        {
          "line": 277,
          "text": "                 Shared Client Runtime"
        },
        {
          "line": 278,
          "text": "                        │"
        },
        {
          "line": 279,
          "text": "      ┌─────────┬─────────┬────────┬─────────┐"
        },
        {
          "line": 280,
          "text": "      │         │         │        │         │"
        },
        {
          "line": 281,
          "text": "     Web      Win       macOS     iOS     Android"
        },
        {
          "line": 282,
          "text": "```"
        },
        {
          "line": 284,
          "text": "---"
        }
      ],
