    {
      "number": 70,
      "title": "Security 核心要求",
      "lineStart": 2565,
      "lineEnd": 2604,
      "sourceUnits": [
        {
          "line": 2565,
          "text": "# 70. Security 核心要求"
        },
        {
          "line": 2567,
          "text": "### Pairing"
        },
        {
          "line": 2569,
          "text": "nonce + expiry + single-use。"
        },
        {
          "line": 2571,
          "text": "### Device Grant"
        },
        {
          "line": 2573,
          "text": "可撤销。"
        },
        {
          "line": 2575,
          "text": "### Transport"
        },
        {
          "line": 2577,
          "text": "加密。"
        },
        {
          "line": 2579,
          "text": "### Remote"
        },
        {
          "line": 2581,
          "text": "不关闭 Host 原有 localhost 防线。"
        },
        {
          "line": 2583,
          "text": "### Relay"
        },
        {
          "line": 2585,
          "text": "不能成为 trusted Host。"
        },
        {
          "line": 2587,
          "text": "### Logs"
        },
        {
          "line": 2589,
          "text": "redact。"
        },
        {
          "line": 2591,
          "text": "### Update"
        },
        {
          "line": 2593,
          "text": "signed only。"
        },
        {
          "line": 2595,
          "text": "### Plugin"
        },
        {
          "line": 2597,
          "text": "最小权限。"
        },
        {
          "line": 2599,
          "text": "### Tool"
        },
        {
          "line": 2601,
          "text": "Host-side enforcement。"
        },
        {
          "line": 2603,
          "text": "---"
        }
      ],
