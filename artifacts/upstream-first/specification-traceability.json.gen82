        },
        {
          "line": 1582,
          "text": "  client/"
        },
        {
          "line": 1583,
          "text": "    connection/"
        },
        {
          "line": 1584,
          "text": "    runtime/"
        },
        {
          "line": 1585,
          "text": "    ui-*/"
        },
        {
          "line": 1587,
          "text": "  interaction/"
        },
        {
          "line": 1589,
          "text": "  session/"
        },
        {
          "line": 1591,
          "text": "  identity/"
        },
        {
          "line": 1592,
          "text": "    device-trust/"
        },
        {
          "line": 1594,
          "text": "  settings/"
        },
        {
          "line": 1596,
          "text": "  credentials/"
        },
        {
          "line": 1598,
          "text": "  diagnostics/"
        },
        {
          "line": 1600,
          "text": "  support/"
        },
        {
          "line": 1601,
          "text": "```"
        },
        {
          "line": 1603,
          "text": "原："
        },
        {
          "line": 1605,
          "text": "```text"
        },
        {
          "line": 1606,
          "text": "packages/remote/link-access"
        },
        {
          "line": 1607,
          "text": "packages/remote/device-trust"
        },
        {
          "line": 1608,
          "text": "packages/remote/link-contracts"
        },
        {
          "line": 1609,
          "text": "```"
        },
        {
          "line": 1611,
          "text": "不能默认原样继续。"
        },
        {
          "line": 1613,
          "text": "先审计："
        },
        {
          "line": 1615,
          "text": "官方当前 API/Connection 能否接管这些责任。"
        },
        {
          "line": 1617,
          "text": "---"
        }
      ],
