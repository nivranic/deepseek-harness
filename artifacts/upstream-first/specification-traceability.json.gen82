        },
        {
          "line": 2619,
          "text": "新建独立 Remote Connection Source。"
        },
        {
          "line": 2621,
          "text": "Web Local："
        },
        {
          "line": 2623,
          "text": "继续原来的 local auth。"
        },
        {
          "line": 2625,
          "text": "Remote："
        },
        {
          "line": 2627,
          "text": "走 Device Trust。"
        },
        {
