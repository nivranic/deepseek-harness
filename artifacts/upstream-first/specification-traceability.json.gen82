    {
      "number": 50,
      "title": "新发现但旧清单没有覆盖的事项",
      "lineStart": 1823,
      "lineEnd": 1904,
      "sourceUnits": [
        {
          "line": 1823,
          "text": "# 50. 新发现但旧清单没有覆盖的事项"
        },
        {
          "line": 1825,
          "text": "必须新增："
        },
        {
          "line": 1827,
          "text": "### Human Interaction Durability"
        },
        {
          "line": 1829,
          "text": "Question/Approval 不能依赖短 HTTP timeout。"
        },
        {
          "line": 1831,
          "text": "### Mutation Idempotency"
        },
        {
          "line": 1833,
          "text": "避免 reconnect 双执行。"
        },
        {
          "line": 1835,
          "text": "### Multiple Client Race"
        },
        {
          "line": 1837,
          "text": "Desktop 与 Mobile 同时审批。"
        },
        {
          "line": 1839,
          "text": "### Host Sleep / Wake"
        },
        {
          "line": 1841,
          "text": "MacBook 合盖。"
        },
        {
          "line": 1843,
          "text": "Windows sleep。"
        },
        {
          "line": 1845,
          "text": "Android/iOS background。"
        },
        {
          "line": 1847,
          "text": "### Clock Skew"
        },
        {
          "line": 1849,
          "text": "Pair challenge 不应单纯相信 Client time。"
        },
        {
          "line": 1851,
          "text": "### Captive Portal"
        },
        {
          "line": 1853,
          "text": "错误 Wi-Fi 网络。"
        },
        {
          "line": 1855,
          "text": "### VPN"
        },
        {
          "line": 1857,
          "text": "VPN 切换。"
        },
        {
          "line": 1859,
          "text": "### IPv4 / IPv6"
        },
        {
          "line": 1861,
          "text": "不要默认 IPv4。"
        },
        {
          "line": 1863,
          "text": "### NAT"
        },
        {
          "line": 1865,
          "text": "LAN discovery 与 remote transport 分开。"
        },
        {
          "line": 1867,
          "text": "### Replay"
        },
        {
          "line": 1869,
          "text": "Pairing nonce 必须一次性。"
        },
        {
          "line": 1871,
          "text": "### Device Re-key"
        },
        {
          "line": 1873,
          "text": "Secure storage 清空后重新配对。"
        },
        {
          "line": 1875,
          "text": "### Host Rename"
        },
        {
          "line": 1877,
          "text": "Host ID 不得绑定 displayName。"
        },
        {
          "line": 1879,
          "text": "### Workspace Move"
        },
        {
          "line": 1881,
          "text": "Session workspace 路径变化必须明确错误。"
        },
        {
          "line": 1883,
          "text": "### Host Reinstall"
        },
        {
          "line": 1885,
          "text": "旧 Device Trust 是否继承必须有规则。"
        },
        {
          "line": 1887,
          "text": "### Large Artifact"
        },
        {
          "line": 1889,
          "text": "需要 backpressure。"
        },
        {
          "line": 1891,
          "text": "### Background Push"
        },
        {
          "line": 1893,
          "text": "Push 只通知："
        },
        {
          "line": 1895,
          "text": "不能成为权威 Session data transport。"
        },
        {
          "line": 1897,
          "text": "### Notification Action"
        },
        {
          "line": 1899,
          "text": "未来从通知直接 Allow 需要严格权限设计。"
        },
        {
          "line": 1901,
          "text": "初期不要做危险审批通知按钮。"
        },
        {
          "line": 1903,
          "text": "---"
        }
      ],
      "verificationStatus": "NOT_STARTED",
      "acceptanceProven": false,
      "owner": "旧能力处置与新增可靠性边界",
