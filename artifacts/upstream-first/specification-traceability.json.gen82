        {
          "line": 838,
          "text": "# 18. Reconnect"
        },
        {
          "line": 840,
          "text": "Connection 状态不要只有："
        },
        {
          "line": 842,
          "text": "```text"
        },
        {
          "line": 843,
          "text": "connected"
        },
        {
          "line": 844,
          "text": "disconnected"
        },
        {
          "line": 845,
          "text": "```"
        },
        {
          "line": 847,
          "text": "至少区分："
        },
        {
          "line": 849,
          "text": "```text"
        },
        {
          "line": 850,
          "text": "connecting"
        },
        {
          "line": 851,
          "text": "authenticating"
        },
        {
          "line": 852,
          "text": "ready"
        },
        {
          "line": 853,
          "text": "offline"
        },
        {
          "line": 854,
          "text": "reconnecting"
        },
        {
          "line": 855,
          "text": "host-not-ready"
        },
        {
          "line": 856,
          "text": "auth-expired"
        },
        {
          "line": 857,
          "text": "device-revoked"
        },
        {
          "line": 858,
          "text": "incompatible"
        },
        {
          "line": 859,
          "text": "fatal"
        },
        {
          "line": 860,
          "text": "```"
        },
        {
          "line": 862,
          "text": "每一种必须提供对应 UX。"
        },
        {
          "line": 864,
          "text": "---"
