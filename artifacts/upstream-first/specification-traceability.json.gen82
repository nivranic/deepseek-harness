    {
      "number": 12,
      "title": "HostDescriptor",
      "lineStart": 646,
      "lineEnd": 699,
      "sourceUnits": [
        {
          "line": 646,
          "text": "# 12. HostDescriptor"
        },
        {
          "line": 648,
          "text": "所有 Client 连接 Host 后第一件事："
        },
        {
          "line": 650,
          "text": "请求："
        },
        {
          "line": 652,
          "text": "`host.describe`"
        },
        {
          "line": 654,
          "text": "建议结构："
        },
        {
          "line": 656,
          "text": "```ts"
        },
        {
          "line": 657,
          "text": "HostDescriptor {"
        },
        {
          "line": 658,
          "text": "  hostId"
        },
        {
          "line": 659,
          "text": "  displayName"
        },
        {
          "line": 661,
          "text": "  productVersion"
        },
        {
          "line": 662,
          "text": "  apiProtocolVersion"
        },
        {
          "line": 663,
          "text": "  sessionFormatVersion"
        },
        {
          "line": 665,
          "text": "  platform"
        },
        {
          "line": 666,
          "text": "  arch"
        },
        {
          "line": 668,
          "text": "  runtimeMode"
        },
        {
          "line": 670,
          "text": "  capabilities[]"
        },
        {
          "line": 672,
          "text": "  transports[]"
        },
        {
          "line": 674,
          "text": "  serverTime"
        },
        {
          "line": 676,
          "text": "  workspaceFacts?"
        },
        {
          "line": 678,
          "text": "  permissionFacts?"
        },
        {
          "line": 679,
          "text": "}"
        },
        {
          "line": 680,
          "text": "```"
        },
        {
          "line": 682,
          "text": "重要："
        },
        {
          "line": 684,
          "text": "必须独立维护："
        },
        {
          "line": 686,
          "text": "```text"
        },
        {
          "line": 687,
          "text": "productVersion"
        },
        {
          "line": 688,
          "text": "apiProtocolVersion"
        },
        {
          "line": 689,
          "text": "sessionFormatVersion"
        },
        {
          "line": 690,
          "text": "```"
        },
        {
          "line": 692,
          "text": "禁止："
        },
        {
          "line": 694,
          "text": "一个 `version=3`"
        },
        {
          "line": 696,
          "text": "同时代表全部东西。"
        },
        {
          "line": 698,
          "text": "---"
        }
      ],
