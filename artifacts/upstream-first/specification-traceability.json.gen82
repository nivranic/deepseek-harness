    {
      "number": 17,
      "title": "Mutation Idempotency",
      "lineStart": 816,
      "lineEnd": 837,
      "sourceUnits": [
        {
          "line": 816,
          "text": "# 17. Mutation Idempotency"
        },
        {
          "line": 818,
          "text": "所有会产生状态变更的 Client 请求建议携带："
        },
        {
          "line": 820,
          "text": "`clientMutationId`"
        },
        {
          "line": 822,
          "text": "例如："
        },
        {
          "line": 824,
          "text": "- send prompt；"
        },
        {
          "line": 825,
          "text": "- approve；"
        },
        {
          "line": 826,
          "text": "- answer；"
        },
        {
          "line": 827,
          "text": "- revoke device；"
        },
        {
          "line": 828,
          "text": "- handoff；"
        },
        {
          "line": 829,
          "text": "- cancel；"
        },
        {
          "line": 830,
          "text": "- rename session。"
        },
        {
