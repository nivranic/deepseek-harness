      "sourceUnits": [
        {
          "line": 2124,
          "text": "# 58. Gate 设计重做"
        },
        {
          "line": 2126,
          "text": "## Gate 0：Upstream Convergence"
        },
        {
          "line": 2128,
          "text": "要求："
        },
        {
          "line": 2130,
          "text": "```text"
        },
        {
          "line": 2131,
          "text": "upstream SHA fixed"
        },
        {
          "line": 2132,
          "text": "delta inventory complete"
        },
        {
          "line": 2133,
          "text": "duplicate architecture classified"
        },
        {
          "line": 2134,
          "text": "migration plan generated"
        },
        {
          "line": 2135,
          "text": "```"
        },
        {
          "line": 2137,
          "text": "未通过："
        },
        {
          "line": 2139,
          "text": "禁止新开发。"
        },
        {
          "line": 2141,
          "text": "---"
        },
        {
          "line": 2143,
          "text": "# Gate 1：Architecture / Contract"
        },
        {
          "line": 2145,
          "text": "要求："
        },
        {
          "line": 2147,
          "text": "- package ownership；"
        },
        {
          "line": 2148,
          "text": "- no duplicate Desktop；"
        },
        {
          "line": 2149,
          "text": "- Typert Contract；"
        },
        {
          "line": 2150,
          "text": "- version negotiation；"
        },
        {
          "line": 2151,
          "text": "- persistence；"
        },
        {
          "line": 2152,
          "text": "- migration；"
        },
        {
          "line": 2153,
          "text": "- error vocabulary；"
        },
        {
          "line": 2154,
          "text": "- unit/contract tests。"
        },
        {
          "line": 2156,
          "text": "必须 machine-readable。"
        },
        {
          "line": 2158,
          "text": "---"
        },
        {
          "line": 2160,
          "text": "# Gate 2：Compatibility / Security"
        },
        {
          "line": 2162,
          "text": "要求："
        },
        {
          "line": 2164,
          "text": "- N/N；"
        },
        {
          "line": 2165,
          "text": "- N/N-1；"
        },
        {
          "line": 2166,
          "text": "- N-1/N；"
        },
        {
          "line": 2167,
          "text": "- Device Trust；"
        },
        {
          "line": 2168,
          "text": "- revoke；"
        },
        {
          "line": 2169,
          "text": "- replay；"
        },
        {
          "line": 2170,
          "text": "- MITM threat review；"
        },
        {
          "line": 2171,
          "text": "- command risk；"
        },
        {
          "line": 2172,
          "text": "- SAST；"
        },
        {
          "line": 2173,
          "text": "- dependency；"
        },
        {
          "line": 2174,
          "text": "- SBOM。"
        },
        {
          "line": 2176,
          "text": "---"
        },
        {
          "line": 2178,
          "text": "# Gate 3：Platform / Native / Recovery"
        },
        {
          "line": 2180,
          "text": "要求："
        },
        {
          "line": 2182,
          "text": "同一候选 SHA。"
        },
        {
          "line": 2184,
          "text": "Windows："
        },
        {
          "line": 2186,
          "text": "真实。"
        },
        {
          "line": 2188,
          "text": "Mac："
        },
        {
          "line": 2190,
          "text": "真实。"
        },
        {
          "line": 2192,
          "text": "Apple："
        },
        {
          "line": 2194,
          "text": "真实。"
        },
        {
          "line": 2196,
          "text": "Android："
        },
        {
          "line": 2198,
          "text": "真实。"
        },
        {
          "line": 2200,
          "text": "覆盖："
        },
        {
          "line": 2202,
          "text": "install / launch / run / recover。"
        },
        {
          "line": 2204,
          "text": "---"
        },
        {
          "line": 2206,
          "text": "# Gate 4：RC"
