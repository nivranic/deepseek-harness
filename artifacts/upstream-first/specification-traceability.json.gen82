      "sourceUnits": [
        {
          "line": 866,
          "text": "# 19. Offline 行为"
        },
        {
          "line": 868,
          "text": "Mobile 断网："
        },
        {
          "line": 870,
          "text": "允许："
        },
        {
          "line": 872,
          "text": "- 查看已有 snapshot；"
        },
        {
          "line": 873,
          "text": "- 查看缓存 UI。"
        },
        {
          "line": 875,
          "text": "禁止："
        },
        {
          "line": 877,
          "text": "自动缓存 Prompt 并在网络恢复后偷偷发送。"
        },
        {
          "line": 879,
          "text": "如果未来支持 offline queue："
        },
        {
          "line": 881,
          "text": "必须明确展示："
        },
        {
          "line": 883,
          "text": "```text"
        },
        {
          "line": 884,
          "text": "待发送 1 条"
        },
        {
          "line": 885,
          "text": "```"
        },
        {
          "line": 887,
          "text": "用户确认后才发。"
        },
        {
          "line": 889,
          "text": "---"
        }
