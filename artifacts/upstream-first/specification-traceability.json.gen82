    {
      "number": 76,
      "title": "下一轮 Agent 实际执行顺序",
      "lineStart": 2789,
      "lineEnd": 2924,
      "sourceUnits": [
        {
          "line": 2789,
          "text": "# 76. 下一轮 Agent 实际执行顺序"
        },
        {
          "line": 2791,
          "text": "严格按以下顺序推进。"
        },
        {
          "line": 2793,
          "text": "## Phase 0"
        },
        {
          "line": 2795,
          "text": "Upstream Refresh。"
        },
        {
          "line": 2797,
          "text": "不写新功能。"
        },
        {
          "line": 2799,
          "text": "---"
        },
        {
          "line": 2801,
          "text": "## Phase 1"
        },
        {
          "line": 2803,
          "text": "Upstream Delta Audit。"
        },
        {
          "line": 2805,
          "text": "建立："
        },
        {
          "line": 2807,
          "text": "```text"
        },
        {
          "line": 2808,
          "text": "Adopt"
        },
        {
          "line": 2809,
          "text": "Adapt"
        },
        {
          "line": 2810,
          "text": "Keep"
        },
        {
          "line": 2811,
          "text": "Migrate"
        },
        {
          "line": 2812,
          "text": "Delete"
        },
        {
          "line": 2813,
          "text": "Experimental"
        },
        {
          "line": 2814,
          "text": "```"
        },
        {
          "line": 2816,
          "text": "六分类。"
        },
        {
          "line": 2818,
          "text": "---"
        },
        {
          "line": 2820,
          "text": "## Phase 2"
        },
        {
          "line": 2822,
          "text": "Desktop Convergence。"
        },
        {
          "line": 2824,
          "text": "将 Windows/macOS Full Runtime 收敛到官方 `apps/desktop`。"
        },
        {
          "line": 2826,
          "text": "---"
        },
        {
          "line": 2828,
          "text": "## Phase 3"
        },
        {
          "line": 2830,
          "text": "Contract Stabilization。"
        },
        {
          "line": 2832,
          "text": "完成："
        },
        {
          "line": 2834,
          "text": "```text"
        },
        {
          "line": 2835,
          "text": "HostDescriptor"
        },
        {
          "line": 2836,
          "text": "Capability"
        },
        {
          "line": 2837,
          "text": "Version"
        },
        {
          "line": 2838,
          "text": "Error"
        },
        {
          "line": 2839,
          "text": "Idempotency"
        },
        {
          "line": 2840,
          "text": "```"
        },
        {
          "line": 2842,
          "text": "---"
        },
        {
          "line": 2844,
          "text": "## Phase 4"
        },
        {
          "line": 2846,
          "text": "Interaction Reliability。"
        },
        {
          "line": 2848,
          "text": "完成："
        },
        {
          "line": 2850,
          "text": "```text"
        },
        {
          "line": 2851,
          "text": "Question"
        },
        {
          "line": 2852,
          "text": "Approval"
        },
        {
          "line": 2853,
          "text": "Reconnect"
        },
        {
          "line": 2854,
          "text": "Multi-client"
        },
        {
          "line": 2855,
          "text": "Cancellation"
        },
        {
          "line": 2856,
          "text": "Recovery"
        },
        {
          "line": 2857,
          "text": "```"
        },
        {
          "line": 2859,
          "text": "---"
        },
        {
          "line": 2861,
          "text": "## Phase 5"
        },
        {
          "line": 2863,
          "text": "Responsive Shared Client。"
        },
        {
          "line": 2865,
          "text": "完成："
