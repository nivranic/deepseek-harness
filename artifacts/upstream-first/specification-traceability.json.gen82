    {
      "number": 14,
      "title": "N / N-1 Compatibility",
      "lineStart": 732,
      "lineEnd": 747,
      "sourceUnits": [
        {
          "line": 732,
          "text": "# 14. N / N-1 Compatibility"
        },
        {
          "line": 734,
          "text": "必须形成正式矩阵："
        },
        {
          "line": 736,
          "text": "| Client | Host | 行为 |"
        },
        {
          "line": 737,
          "text": "|---|---|---|"
        },
        {
          "line": 738,
          "text": "| N | N | Full |"
        },
        {
          "line": 739,
          "text": "| N | N-1 | Negotiated subset |"
        },
        {
          "line": 740,
          "text": "| N-1 | N | 兼容上一协议 |"
        },
        {
          "line": 741,
          "text": "| N-2 | N | Diagnostics only |"
        },
        {
          "line": 742,
          "text": "| Unknown | N | Reject + upgrade |"
        },
        {
          "line": 744,
          "text": "Session disk format 不由 Client 直接解析。"
        },
        {
          "line": 746,
          "text": "---"
        }
      ],
