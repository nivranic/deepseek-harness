    {
      "number": 75,
      "title": "最终产品形态",
      "lineStart": 2741,
      "lineEnd": 2788,
      "sourceUnits": [
        {
          "line": 2741,
          "text": "# 75. 最终产品形态"
        },
        {
          "line": 2743,
          "text": "理想目标不是："
        },
        {
          "line": 2745,
          "text": "```text"
        },
        {
          "line": 2746,
          "text": "Windows 产品"
        },
        {
          "line": 2747,
          "text": "Mac 产品"
        },
        {
          "line": 2748,
          "text": "iOS 产品"
        },
        {
          "line": 2749,
          "text": "Android 产品"
        },
        {
          "line": 2750,
          "text": "Web 产品"
        },
        {
          "line": 2751,
          "text": "```"
        },
        {
          "line": 2753,
          "text": "各自维护 Agent。"
        },
        {
          "line": 2755,
          "text": "而是："
        },
        {
          "line": 2757,
          "text": "```text"
        },
        {
          "line": 2758,
          "text": "                 DeepSeek Harness Platform"
        },
        {
          "line": 2760,
          "text": "                        Core Host"
        },
        {
          "line": 2761,
          "text": "                           │"
        },
        {
          "line": 2762,
          "text": "           Session / Tool / Interaction"
        },
        {
          "line": 2763,
          "text": "                           │"
        },
        {
          "line": 2764,
          "text": "                    Typed Contract"
        },
        {
          "line": 2765,
          "text": "                           │"
        },
        {
          "line": 2766,
          "text": "                     Connection"
        },
        {
          "line": 2767,
          "text": "                           │"
        },
        {
          "line": 2768,
          "text": "        ┌──────────┬───────┼───────┬──────────┐"
        },
        {
          "line": 2769,
          "text": "        │          │       │       │          │"
        },
        {
          "line": 2770,
          "text": "       Web       Win      Mac     iOS      Android"
        },
        {
          "line": 2771,
          "text": "```"
        },
        {
          "line": 2773,
          "text": "平台差异只保留在真正需要 native 的地方："
        },
        {
          "line": 2775,
          "text": "- secure storage；"
        },
        {
          "line": 2776,
          "text": "- window；"
        },
        {
          "line": 2777,
          "text": "- notification；"
        },
        {
          "line": 2778,
          "text": "- share；"
        },
        {
          "line": 2779,
          "text": "- camera；"
        },
        {
          "line": 2780,
          "text": "- deep link；"
        },
        {
          "line": 2781,
          "text": "- filesystem picker；"
        },
        {
          "line": 2782,
          "text": "- background lifecycle；"
        },
        {
          "line": 2783,
          "text": "- install/update。"
        },
        {
          "line": 2785,
          "text": "Agent/Session/Approval/Tool 等核心语义保持唯一。"
        },
        {
          "line": 2787,
          "text": "---"
        }
      ],
