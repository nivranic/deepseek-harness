    {
      "number": 10,
      "title": "Conversation 页面推荐结构",
      "lineStart": 583,
      "lineEnd": 625,
      "sourceUnits": [
        {
          "line": 583,
          "text": "# 10. Conversation 页面推荐结构"
        },
        {
          "line": 585,
          "text": "Phone："
        },
        {
          "line": 587,
          "text": "```text"
        },
        {
          "line": 588,
          "text": "┌──────────────────────────┐"
        },
        {
          "line": 589,
          "text": "│ ← Sessions    Host ●  ⋮  │"
        },
        {
          "line": 590,
          "text": "├──────────────────────────┤"
        },
        {
          "line": 591,
          "text": "│                          │"
        },
        {
          "line": 592,
          "text": "│ User                     │"
        },
        {
          "line": 593,
          "text": "│                          │"
        },
        {
          "line": 594,
          "text": "│ Agent                    │"
        },
        {
          "line": 595,
          "text": "│                          │"
        },
        {
          "line": 596,
          "text": "│ Tool                     │"
        },
        {
          "line": 597,
          "text": "│ ┌──────────────────────┐ │"
        },
        {
          "line": 598,
          "text": "│ │ ✓ tests passed       │ │"
        },
        {
          "line": 599,
          "text": "│ └──────────────────────┘ │"
        },
        {
          "line": 600,
          "text": "│                          │"
        },
        {
          "line": 601,
          "text": "│ Approval                 │"
        },
        {
          "line": 602,
          "text": "│                          │"
        },
        {
          "line": 603,
          "text": "│ [拒绝]       [允许一次] │"
        },
        {
          "line": 604,
          "text": "│                          │"
        },
        {
          "line": 605,
          "text": "├──────────────────────────┤"
        },
        {
          "line": 606,
          "text": "│ Ask DeepSeek...          │"
        },
        {
          "line": 607,
          "text": "│ +       Model      ↑     │"
        },
        {
          "line": 608,
          "text": "└──────────────────────────┘"
        },
        {
          "line": 609,
          "text": "```"
        },
        {
          "line": 611,
          "text": "运行 Host 必须明显显示："
        },
        {
          "line": 613,
          "text": "```text"
        },
        {
          "line": 614,
          "text": "运行位置"
        },
        {
          "line": 615,
          "text": "Workstation"
        },
        {
          "line": 616,
          "text": "Windows"
        },
        {
          "line": 617,
          "text": "workspace-write"
        },
        {
          "line": 618,
          "text": "```"
        },
        {
          "line": 620,
          "text": "手机打开 Session 时："
        },
        {
          "line": 622,
          "text": "> 不允许用户误以为命令将在手机执行。"
        },
        {
          "line": 624,
          "text": "---"
        }
