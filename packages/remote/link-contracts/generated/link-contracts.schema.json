        "e"
      ]
    },
    "LinkStreamFrame": {
      "type": "object",
      "properties": {
        "k": {
          "$ref": "#/$defs/LinkStreamFrameKind"
        },
        "v": true,
        "c": {
          "type": "string"
        },
        "m": {
          "type": "string"
        },
        "d": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "k"
      ],
      "additionalProperties": true
    },
    "LinkRemoteEventFrameKind": {
