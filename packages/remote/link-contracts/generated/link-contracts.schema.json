{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepSeek Harness Link Contract",
  "x-dsh-contractVersion": 1,
  "x-dsh-protocol": {
    "linkProtocolVersion": 1,
    "sessionFormatVersion": 0,
    "rpc": {
      "requestArguments": "payload.args",
      "voidSuccess": "ok-with-omitted-value",
      "failure": "structured-error"
    },
    "stream": {
      "requestArguments": "args",
      "frames": [
        "value",
        "error"
      ],
      "cancellation": "transport-abort"
    },
    "remoteEvents": {
      "downlink": [
        "ready",
        "emit",
        "waterfall",
        "cancel"
      ],
      "resultOutcomes": [
        "next",
        "result",
        "rejected"
      ],
      "clientIdentity": "ready.clientId"
    },
    "sequence": {
      "event": "monotonic-seq",
      "cursor": "highest-included-seq",
      "replay": "ignore-seq-at-or-below-cursor"
    },
    "compatibility": {
      "unknownOptionalFields": "ignore",
      "unknownEventTypes": "preserve",
      "missingRequiredFields": "reject"
    },
    "routes": {
      "pair": "/link/pair",
      "describe": "/link/describe",
      "unaryPrefix": "/api/",
      "streamPrefix": "/link/stream/",
      "remoteEventStream": "$events",
      "remoteEventResult": "$events/result"
    },
    "authenticationHeaders": {
      "deviceId": "x-dsh-device-id",
      "timestamp": "x-dsh-timestamp",
      "signature": "x-dsh-signature"
    }
  },
  "$defs": {
    "LinkDeviceRole": {
      "type": "string",
      "enum": [
        "observer",
        "controller",
        "administrator"
      ]
    },
    "LinkError": {
      "type": "string",
      "enum": [
        "link-unavailable",
        "link-disabled",
        "bad-request"
      ]
    },
    "LinkJsonValue": true,
    "LinkPairRequest": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "devicePublicKey": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "deviceName",
        "devicePublicKey"
      ],
      "additionalProperties": true
    },
    "LinkRpcPayload": {
      "type": "object",
      "properties": {
        "args": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": true
    },
    "LinkRpcRequestEnvelope": {
      "type": "object",
      "properties": {
        "type": {
          "const": "client-request"
        },
        "rpcId": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/LinkRpcPayload"
        }
      },
      "required": [
        "type",
        "rpcId",
        "method",
        "payload"
      ],
      "additionalProperties": true
    },
    "LinkRpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": true
    },
    "LinkRpcResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": true,
        "error": {
          "$ref": "#/$defs/LinkRpcError"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": true
    },
    "LinkRpcResponseEnvelope": {
      "type": "object",
      "properties": {
        "type": {
          "const": "server-response"
        },
        "rpcId": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/LinkRpcResult"
        }
      },
      "required": [
        "type",
        "rpcId",
        "result"
      ],
      "additionalProperties": true
    },
    "LinkStreamRequest": {
      "type": "object",
      "properties": {
        "args": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": true
    },
    "LinkStreamFrameKind": {
      "type": "string",
      "enum": [
